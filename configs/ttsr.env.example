# Initial policy and the complete test-question parquet X_test.
export MODEL_PATH=./models/base
export TEST_FILE=./data/test.parquet
# Optional held-out validation file; defaults to TEST_FILE.
export VAL_FILE=./data/test.parquet

# TTSR outer loop
export WORK_DIR=./runs/ttsr_loop
export ROUNDS=3
export MAX_VARIANTS=8
export ROLLOUT_N=16
export TRAIN_BATCH_SIZE=64
export N_GPUS=1

# Teacher GRPO stage
export TEACHER_TOTAL_STEPS=10
export TEACHER_TOTAL_EPOCHS=1
export TEACHER_ROLLOUT_N=4
export TEACHER_TRAIN_BATCH_SIZE=32
export TTSR_TAU=0.75
export TTSR_LAMBDA=1.0
export STUDENT_EVAL_TIMEOUT_S=240
export TEACHER_REWARD_RESULT_TIMEOUT_S=300

# Student evaluator used for the paper frontier reward 4s(1-s).
# Either point STUDENT_EVAL_URL at an already-running evaluator, or reserve
# GPUs for the loop to launch a local evaluator snapshot after each Student round.
# Keep teacher training and the evaluator on disjoint visible GPUs.
export TRAIN_CUDA_VISIBLE_DEVICES=0
export STUDENT_EVAL_URL=
export STUDENT_EVAL_CUDA_VISIBLE_DEVICES=1
export STUDENT_EVAL_PORT=8877
export STUDENT_EVAL_GPU_MEMORY_UTILIZATION=0.8
export STUDENT_EVAL_TENSOR_PARALLEL_SIZE=1

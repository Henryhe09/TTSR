# Base model
export MODEL_PATH=/path/to/base/model

# Prepared verl parquet files
export BASE_TRAIN=/path/to/data/train.parquet
export BASE_VAL=/path/to/data/test.parquet

# Runtime
export WORK_DIR=./runs/ttsr_loop
export ROUNDS=3
export MAX_VARIANTS=8
export REAL_RATIO=5.0
export ROLLOUT_N=8
export TRAIN_BATCH_SIZE=64
export N_GPUS=1

# Teacher GRPO stage
export TEACHER_TOTAL_STEPS=10
export TEACHER_TOTAL_EPOCHS=1
export TEACHER_ROLLOUT_N=4
export TEACHER_TRAIN_BATCH_SIZE=32
export TEACHER_MAX_TRAIN_SAMPLES=0
export FRONTIER_TARGET_SIMILARITY=0.55
export TTSR_TAU=0.75
export TTSR_LAMBDA=1.0
